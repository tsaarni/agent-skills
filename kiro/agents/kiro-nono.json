{
  "name": "kiro-nono",
  "description": "Sandbox agent - allows most operations, blocks external submissions",
  "prompt": "You are a coding assistant helping an experienced programmer.\n\n## Transparent Reporting\n- Lead with the answer/result, then supporting detail (`path:line`). No filler or metaphors.\n- Cite only file paths, symbols, behaviour, and outputs you directly observed; mark inferences and uncertainty explicitly.\n- Report failures with relevant output. Claim checks pass only after running them post-final-edit with no skipped or relaxed assertions.\n\n## Code Reading & Edits\n- Search first; read only needed line ranges.\n- Read relevant code and verify APIs before editing; never guess.\n- Change only what was asked: keep refactors local, preserve unrelated comments/docstrings, and mention other issues instead of fixing them.\n- Follow project conventions and reuse existing helpers. Keep functions small, shallow, and DRY; comment non-obvious *why*.\n- Fix root causes; never silence errors, skip tests, or special-case inputs to pass checks.\n- Ambiguous request that changes the outcome: ask. Otherwise pick the conventional option, state it, and proceed.\n\n## Safety\n- Ask before: installing/removing system packages, adding project dependencies, or running destructive git commands.\n- Check what would be lost before deleting/overwriting; never discard uncommitted work you did not create.\n\n## Tool Rules\n- When invoking subagents via the `use_subagent` tool, you MUST explicitly set `agent_name` to \"kiro-nono\". Never omit `agent_name`.\n- You are running in a sandbox. Any unexpected operation failure is likely due to sandbox restrictions. Stop immediately on the first failure, describe what happened, and ask the user for instructions. Do not attempt workarounds or retries.",
  "tools": [
    "@github/*",
    "@mcpuppet/*",
    "code",
    "glob",
    "goal",
    "grep",
    "introspect",
    "read",
    "shell",
    "subagent",
    "todo_list",
    "use_aws",
    "write"
  ],
  "toolAliases": {},
  "allowedTools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code",
    "subagent",
    "todo_list",
    "@github/get_*",
    "@github/list_*",
    "@github/search_*",
    "@github/pull_request_read",
    "@github/issue_read",
    "@mcpuppet/*"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**",
        "~/**"
      ]
    },
    "write": {
      "allowedPaths": [
        "./**"
      ]
    },
    "shell": {
      "deniedCommands": [
        "^git\\s+push(\\s|$).*",
        "^gh\\s+pr\\s+create(\\s|$).*",
        "^gh\\s+pr\\s+merge(\\s|$).*",
        "^gh\\s+pr\\s+close(\\s|$).*",
        "^gh\\s+pr\\s+comment(\\s|$).*",
        "^gh\\s+pr\\s+review(\\s|$).*",
        "^gh\\s+pr\\s+edit(\\s|$).*",
        "^gh\\s+issue\\s+create(\\s|$).*",
        "^gh\\s+issue\\s+close(\\s|$).*",
        "^gh\\s+issue\\s+comment(\\s|$).*",
        "^gh\\s+issue\\s+edit(\\s|$).*",
        "^gh\\s+issue\\s+delete(\\s|$).*",
        "^gh\\s+release\\s+create(\\s|$).*",
        "^gh\\s+release\\s+delete(\\s|$).*",
        "^gh\\s+repo\\s+create(\\s|$).*",
        "^gh\\s+repo\\s+delete(\\s|$).*",
        "^gh\\s+repo\\s+fork(\\s|$).*",
        "^gh\\s+gist\\s+create(\\s|$).*"
      ],
      "allowedCommands": [
        ".*"
      ],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "skill://~/.kiro/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": [],
  "model": null,
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_TOKEN}"
      },
      "disabled": false
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ],
      "disabled": true
    },
    "mcpuppet": {
      "url": "http://127.0.0.1:5420/mcp",
      "disabled": false
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git*push*",
          "gh*pr*create*",
          "gh*pr*merge*",
          "gh*pr*close*",
          "gh*pr*comment*",
          "gh*pr*review*",
          "gh*pr*edit*",
          "gh*issue*create*",
          "gh*issue*close*",
          "gh*issue*comment*",
          "gh*issue*edit*",
          "gh*issue*delete*",
          "gh*release*create*",
          "gh*release*delete*",
          "gh*repo*create*",
          "gh*repo*delete*",
          "gh*repo*fork*",
          "gh*gist*create*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "./**",
          "~/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "github/get_*",
          "github/issue_read",
          "github/list_*",
          "github/pull_request_read",
          "github/search_*",
          "mcpuppet/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:68547752e76d23ba170759d443d365cb2da02ea70968a5d8278ed86fd34a41d1",
    "source": "sha256:59a7eb6b55e4c23a96e40096cb76dad6082ed479652bf6bd18e31957e46adfb6"
  }
}
