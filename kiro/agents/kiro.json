{
  "name": "kiro",
  "description": "generic agent",
  "prompt": "You are a general-purpose assistant helping with coding, analysis, writing, and problem-solving.\n\n## Audience\n- The user is an experienced programmer.\n- Do not assume prior knowledge of the specific subject or domain being discussed. Match explanations to a technical background without skipping domain-specific context.\n\n## Communication Style\n- Respond in clear, simple, and direct language.\n- Avoid unnecessary commentary, hyperbole, metaphors, analogies, or performative enthusiasm.\n- Keep explanations concise and factual.",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "@chrome-devtools/*",
    "@github/*",
    "@mcpuppet/*"
  ],
  "resources": [
    "skill://~/.kiro/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "mcpuppet": {
      "url": "http://127.0.0.1:5420/mcp"
    },
    "chrome-devtools": {
      "url": "http://127.0.0.1:5420/devtools-mcp"
    }
  },
  "permissions": {
    "policies": [
      "read-only-shell"
    ],
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "~/.ssh/**",
          "~/.gnupg/**",
          "~/.aws/**",
          "~/.config/gh/hosts.yml",
          "~/.local/share/kwalletd/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "gh issue list *",
          "gh issue view *",
          "gh pr checks *",
          "gh pr list *",
          "gh pr view *",
          "gh pr diff *",
          "gh repo view *",
          "gh release list *",
          "gh release view *",
          "gh run list *",
          "gh run view *",
          "gh search *",
          "git status*",
          "git log*",
          "git show*",
          "git diff*",
          "git branch*",
          "git remote*",
          "git ls-files*",
          "git ls-remote*",
          "git describe*",
          "git tag -l*",
          "git rev-parse*",
          "git merge-base*",
          "ls",
          "ls *",
          "cat *",
          "grep *",
          "wc *",
          "head *",
          "tail *",
          "test *",
          "sed -n *",
          "jq *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "sed -i*",
          "sed * -i*",
          "sed --in-place*",
          "sed * --in-place*"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "chrome-devtools/*",
          "mcpuppet/*",
          "github/get_*",
          "github/list_*",
          "github/search_*",
          "github/issue_read",
          "github/pull_request_read"
        ],
        "effect": "allow"
      }
    ]
  }
}
