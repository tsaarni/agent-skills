{
  "name": "kiro-sandbox",
  "description": "Sandbox agent - allows most operations, blocks external submissions",
  "prompt": "You are a general-purpose assistant helping with coding, analysis, writing, and problem-solving.\n\n## Audience\n- The user is an experienced programmer.\n- Do not assume prior knowledge of the specific subject or domain being discussed. Match explanations to a technical background without skipping domain-specific context.\n\n## Communication Style\n- Respond in clear, simple, and direct language.\n- Avoid unnecessary commentary, hyperbole, metaphors, analogies, or performative enthusiasm.\n- Keep explanations concise and factual.\n\n## Tool Rules\n- When invoking subagents via the `use_subagent` tool, you MUST explicitly set `agent_name` to \"kiro-sandbox\". Never omit `agent_name`.\n- Never push code or submit anything to GitHub or any external service.\n-  You are running inside a gravelpit sandbox. If a command fails and stderr contains `[gravelpit]`, the failure is a sandbox restriction. Report the message to the user and stop. Do not try to work around it with chmod or sudo.",
  "tools": [
    "@chrome-devtools/*",
    "@github/*",
    "@mcpuppet/*",
    "code",
    "glob",
    "goal",
    "grep",
    "introspect",
    "read",
    "shell",
    "subagent",
    "todo_list",
    "use_aws",
    "write"
  ],
  "toolAliases": {},
  "allowedTools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code",
    "subagent",
    "todo_list",
    "@github/get_*",
    "@github/list_*",
    "@github/search_*",
    "@github/pull_request_read",
    "@github/issue_read",
    "@mcpuppet/*",
    "@chrome-devtools/*"
  ],
  "toolsSettings": {
    "fs_read": {
      "allowedPaths": [
        "./**",
        "~/**"
      ]
    },
    "write": {
      "allowedPaths": [
        "./**"
      ]
    },
    "shell": {
      "deniedCommands": [
        "^git\\s+push(\\s|$).*",
        "^gh\\s+pr\\s+create(\\s|$).*",
        "^gh\\s+pr\\s+merge(\\s|$).*",
        "^gh\\s+pr\\s+close(\\s|$).*",
        "^gh\\s+pr\\s+comment(\\s|$).*",
        "^gh\\s+pr\\s+review(\\s|$).*",
        "^gh\\s+pr\\s+edit(\\s|$).*",
        "^gh\\s+issue\\s+create(\\s|$).*",
        "^gh\\s+issue\\s+close(\\s|$).*",
        "^gh\\s+issue\\s+comment(\\s|$).*",
        "^gh\\s+issue\\s+edit(\\s|$).*",
        "^gh\\s+issue\\s+delete(\\s|$).*",
        "^gh\\s+release\\s+create(\\s|$).*",
        "^gh\\s+release\\s+delete(\\s|$).*",
        "^gh\\s+repo\\s+create(\\s|$).*",
        "^gh\\s+repo\\s+delete(\\s|$).*",
        "^gh\\s+repo\\s+fork(\\s|$).*",
        "^gh\\s+gist\\s+create(\\s|$).*"
      ],
      "allowedCommands": [
        ".*"
      ],
      "autoAllowReadonly": true
    }
  },
  "resources": [
    "skill://~/.kiro/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": [],
  "model": null,
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_TOKEN}"
      },
      "disabled": false
    },
    "mcpuppet": {
      "url": "http://127.0.0.1:5420/mcp",
      "disabled": false
    },
    "chrome-devtools": {
      "url": "http://127.0.0.1:5420/devtools-mcp",
      "disabled": false
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git*push*",
          "gh*pr*create*",
          "gh*pr*merge*",
          "gh*pr*close*",
          "gh*pr*comment*",
          "gh*pr*review*",
          "gh*pr*edit*",
          "gh*issue*create*",
          "gh*issue*close*",
          "gh*issue*comment*",
          "gh*issue*edit*",
          "gh*issue*delete*",
          "gh*release*create*",
          "gh*release*delete*",
          "gh*repo*create*",
          "gh*repo*delete*",
          "gh*repo*fork*",
          "gh*gist*create*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "./**",
          "~/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "./**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "chrome-devtools/*",
          "github/get_*",
          "github/issue_read",
          "github/list_*",
          "github/pull_request_read",
          "github/search_*",
          "mcpuppet/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
