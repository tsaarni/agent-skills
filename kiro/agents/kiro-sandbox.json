{
  "name": "kiro-sandbox",
  "description": "Sandbox agent - allows most operations, blocks external submissions",
  "prompt": "You are a general-purpose assistant helping with coding, analysis, writing, and problem-solving.\n\n## Audience\n- The user is an experienced programmer.\n- Do not assume prior knowledge of the specific subject or domain being discussed. Match explanations to a technical background without skipping domain-specific context.\n\n## Communication Style\n- Respond in clear, simple, and direct language.\n- Avoid unnecessary commentary, hyperbole, metaphors, analogies, or performative enthusiasm.\n- Keep explanations concise and factual.\n\n## Rules\n- Never push code or submit anything to GitHub or any external service.\n- You are running inside a gravelpit sandbox. If a command fails and stderr contains `[gravelpit]`, the failure is a sandbox restriction. Report the message to the user and stop. Do not try to work around it with chmod or sudo.",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "@chrome-devtools/*",
    "@github/*",
    "@mcpuppet/*"
  ],
  "resources": [
    "skill://~/.kiro/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "mcpuppet": {
      "url": "http://127.0.0.1:5420/mcp"
    },
    "chrome-devtools": {
      "url": "http://127.0.0.1:5420/devtools-mcp"
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "filesystem",
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "~/.ssh/**",
          "~/.gnupg/**",
          "~/.aws/**",
          "~/.config/gh/hosts.yml",
          "~/.local/share/kwalletd/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git -* push*",
          "gh pr create*",
          "gh pr merge*",
          "gh pr close*",
          "gh pr reopen*",
          "gh pr ready*",
          "gh pr comment*",
          "gh pr review*",
          "gh pr edit*",
          "gh issue create*",
          "gh issue close*",
          "gh issue reopen*",
          "gh issue comment*",
          "gh issue edit*",
          "gh issue delete*",
          "gh release create*",
          "gh release edit*",
          "gh release upload*",
          "gh release delete*",
          "gh repo create*",
          "gh repo edit*",
          "gh repo rename*",
          "gh repo archive*",
          "gh repo delete*",
          "gh repo fork*",
          "gh gist create*",
          "gh gist edit*",
          "gh gist delete*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "gh api*"
        ],
        "effect": "ask"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "chrome-devtools/*",
          "mcpuppet/*",
          "github/get_*",
          "github/list_*",
          "github/search_*",
          "github/issue_read",
          "github/pull_request_read"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "github/*"
        ],
        "exclude": [
          "github/get_*",
          "github/list_*",
          "github/search_*",
          "github/issue_read",
          "github/pull_request_read"
        ],
        "effect": "deny"
      }
    ]
  }
}
