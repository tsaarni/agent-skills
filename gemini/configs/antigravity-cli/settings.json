{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "model": "Gemini 4 Hydrogen (Medium)",
  "permissions": {
    "allow": [
      "command(regex:^sed\\b.*)",
      "command(regex:^awk\\b.*)",
      "command(pnpm)",
      "command(uv)",
      "command(go)",
      "command(python3)",
      "command(runagent)",
      "command(ls)",
      "command(find)",
      "command(grep)",
      "command(rg)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(diff)",
      "command(which)",
      "command(file)",
      "command(jq)",
      "command(make)",
      "command(echo)",
      "command(kubectl)",
      "command(node)",
      "command(curl)",
      "command(http)",
      "command(regex:^git(\\s+(-C\\s+(\\S+|\"[^\"]+\"|'[^']+')|--no-pager))*\\s+(status|diff|show|log|grep|branch|rev-parse|ls-files|remote|describe|tag|blame|check-ignore)\\b.*)",
      "execute_url(localhost)",
      "mcp(chrome-devtools/list_pages)",
      "mcp(chrome-devtools/evaluate_script)",
      "mcp(chrome-devtools/press_key)",
      "mcp(chrome-devtools/new_page)",
      "mcp(chrome-devtools/navigate_page)",
      "mcp(chrome-devtools/performance_start_trace)",
      "mcp(chrome-devtools/select_page)",
      "mcp(chrome-devtools/list_console_messages)",
      "mcp(chrome-devtools/click)",
      "mcp(chrome-devtools/take_screenshot)",
      "mcp(chrome-devtools/resize_page)",
      "command(adb)",
      "command(jadx)",
      "command(unzip)",
      "command(strings)",
      "command(date)",
      "command(locale)",
      "command(env)",
      "command(printenv)",
      "command(pwd)",
      "command(uname)",
      "command(sw_vers)",
      "command(ps)",
      "command(lsof)",
      "command(netstat)",
      "command(df)",
      "command(du)",
      "command(stat)",
      "command(readlink)",
      "command(realpath)",
      "command(man)",
      "command(nm)",
      "command(colima)",
      "command(kind)",
      "command(docker)",
      "command(dig)",
      "command(nslookup)",
      "command(regex:^openssl\\s+(x509|s_client|verify|version|crl)\\b.*)",
      "command(sort)",
      "command(uniq)",
      "command(cut)",
      "command(tr)",
      "command(basename)",
      "command(dirname)",
      "command(printf)",
      "command(true)",
      "command(yq)",
      "command(regex:^helm\\s+(list|status|get|show|version)\\b.*)",
      "command(base64)",
      "command(shasum)",
      "command(sha256sum)",
      "command(md5)",
      "command(regex:^brew\\s+(list|info|search|deps|services\\s+list|--version)\\b.*)",
      "command(golangci-lint)",
      "command(gofmt)"
    ]
  },
  "screenBuffer": "never",
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "trustedWorkspaces": [],
  "verbosity": "high"
}
