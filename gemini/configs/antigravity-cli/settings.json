{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "model": "Gemini 3.8 Flash (Medium)",
  "permissions": {
    "allow": [
      "command(regex:^sed\\b.*)",
      "command(regex:^awk\\b.*)",
      "command(pnpm)",
      "command(uv)",
      "command(go)",
      "command(python3)",
      "command(runagent)",
      "command(ls)",
      "command(find)",
      "command(grep)",
      "command(rg)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(diff)",
      "command(which)",
      "command(file)",
      "command(jq)",
      "command(make)",
      "command(echo)",
      "command(kubectl)",
      "command(node)",
      "command(curl)",
      "command(http)",
      "command(regex:^git(\\s+(-C\\s+(\\S+|\"[^\"]+\"|'[^']+')|--no-pager))*\\s+(status|diff|show|log|grep|branch|rev-parse|ls-files|remote|describe|tag|blame|check-ignore)\\b.*)",
      "execute_url(localhost)",
      "mcp(chrome-devtools/list_pages)",
      "mcp(chrome-devtools/evaluate_script)",
      "mcp(chrome-devtools/press_key)",
      "mcp(chrome-devtools/new_page)",
      "mcp(chrome-devtools/navigate_page)",
      "mcp(chrome-devtools/performance_start_trace)",
      "mcp(chrome-devtools/select_page)",
      "mcp(chrome-devtools/list_console_messages)",
      "mcp(chrome-devtools/click)",
      "mcp(chrome-devtools/take_screenshot)",
      "mcp(chrome-devtools/resize_page)",
      "command(ls $(go env GOMODCACHE)/golang.org/x/sys/ 2>/dev/null || true)",
      "command(./audit)",
      "command(awk '{print $2}')",
      "command(adb)",
      "command(jadx)",
      "command(unzip)",
      "command(strings)"
    ]
  },
  "screenBuffer": "never",
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true
  },
  "trustedWorkspaces": [],
  "verbosity": "high"
}
