{
  "defaultLimit": 100,
  "defaultTimeoutMs": 15000,
  "workspaceSearchTimeoutMs": 45000,
  "languages": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "detection": {
        "files": ["tsconfig.json", "package.json"],
        "extensions": [".ts", ".tsx", ".cts", ".mts"]
      }
    },
    "javascript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "detection": {
        "files": ["jsconfig.json", "package.json"],
        "extensions": [".js", ".jsx", ".cjs", ".mjs"]
      }
    },
    "python": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "detection": {
        "files": ["requirements.txt", "pyproject.toml", "setup.py", "Pipfile"],
        "extensions": [".py"]
      }
    },
    "go": {
      "command": "gopls",
      "args": [],
      "detection": {
        "files": ["go.mod", "go.work"],
        "extensions": [".go"]
      }
    },
    "rust": {
      "command": "rust-analyzer",
      "args": [],
      "detection": {
        "files": ["Cargo.toml"],
        "extensions": [".rs"]
      }
    },
    "java": {
      "command": "jdtls",
      "args": [],
      "detection": {
        "files": [
          "pom.xml",
          "build.gradle",
          "build.gradle.kts",
          "settings.gradle",
          "settings.gradle.kts"
        ],
        "extensions": [".java"]
      }
    },
    "cpp": {
      "command": "clangd",
      "args": [],
      "detection": {
        "files": ["compile_commands.json", "compile_flags.txt", "CMakeLists.txt"],
        "extensions": [".cpp", ".c", ".h", ".hpp", ".cc", ".cxx", ".hxx"]
      }
    }
  }
}
