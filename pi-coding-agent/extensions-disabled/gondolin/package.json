{
  "name": "pi-extension-gondolin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "postinstall": "node scripts/link-krun-runner.cjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --fix ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0",
    "@earendil-works/pi-coding-agent": "0.80.2",
    "@earendil-works/pi-tui": "^0.80.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "26.0.1"
  }
}
