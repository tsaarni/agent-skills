{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Prompts",
  "description": "Array of prompts with expected outcomes.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["prompt", "should_call"],
    "additionalProperties": false,
    "properties": {
      "prompt": { "type": "string" },
      "should_call": { "type": "boolean" }
    }
  }
}
