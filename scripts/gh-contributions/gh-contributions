#!/usr/bin/env python3
"""
Fetch GitHub contributions using the `gh` CLI, grouped by repository, type, and state.

Queries:
  authored   - Issues and PRs created by the user
  reviewed   - PRs reviewed by the user (excluding own)
  commented  - Issues and PRs the user commented on (excluding authored)

Requires: gh CLI (authenticated)
"""

import argparse
import json
import re
import subprocess
import sys
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta


# ---------------------------------------------------------------------------
# Period parsing
# ---------------------------------------------------------------------------

def parse_period(value):
    """Parse a period string into (since, until) date strings.

    Supported formats:
        YYYY-MM-DD..YYYY-MM-DD   explicit range
        YYYY-MM-DD..             since date to now
        YYYY                     full year
        YYYY-MM                  full month
        YYYY-qN or qN            quarter (qN alone uses current year)
        last-N-days              rolling window
    """
    today = date.today()

    # Explicit range: 2026-01-01..2026-06-30 or 2026-01-01..
    if ".." in value:
        parts = value.split("..", 1)
        since = parts[0]
        until = parts[1] if parts[1] else None
        return since, until

    # Quarter: q3, Q3, 2026-q3, 2026-Q3
    m = re.fullmatch(r"(?:(\d{4})-)?[qQ]([1-4])", value)
    if m:
        year = int(m.group(1)) if m.group(1) else today.year
        q = int(m.group(2))
        first_month = (q - 1) * 3 + 1
        since = date(year, first_month, 1)
        if q < 4:
            until = date(year, first_month + 3, 1) - timedelta(days=1)
        else:
            until = date(year, 12, 31)
        return str(since), str(until)

    # Year: 2026
    if re.fullmatch(r"\d{4}", value):
        return f"{value}-01-01", f"{value}-12-31"

    # Month: 2026-09
    if re.fullmatch(r"\d{4}-\d{2}", value):
        y, m_val = value.split("-")
        since = date(int(y), int(m_val), 1)
        if int(m_val) == 12:
            until = date(int(y), 12, 31)
        else:
            until = date(int(y), int(m_val) + 1, 1) - timedelta(days=1)
        return str(since), str(until)

    # Rolling: last-30-days, last-7-days
    m = re.fullmatch(r"last-(\d+)-days", value)
    if m:
        days = int(m.group(1))
        since = today - timedelta(days=days)
        return str(since), None

    # Explicit date
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
        return value, None

    print(f"error: unrecognized period format: {value}", file=sys.stderr)
    print("Run with --help to see supported formats.", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# GitHub CLI wrapper
# ---------------------------------------------------------------------------

def gh_search(kind, flags, fields, limit=200, qualifiers=None):
    """Run `gh search <kind>` and return parsed JSON."""
    cmd = [
        "gh", "search", kind,
        *flags,
        f"--limit={limit}",
        f"--json={','.join(fields)}",
    ]
    if qualifiers:
        cmd.extend(["--", *qualifiers])

    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"error: gh search {kind} failed: {result.stderr.strip()}", file=sys.stderr)
        return []
    if not result.stdout.strip():
        return []
    results = json.loads(result.stdout)
    if len(results) >= limit:
        print(
            f"warning: gh search {kind} returned {len(results)} results (hit --limit={limit}); "
            "output may be truncated — increase --limit or narrow --period",
            file=sys.stderr,
        )
    return results


# ---------------------------------------------------------------------------
# Contribution fetching
# ---------------------------------------------------------------------------

FIELDS = [
    "repository", "state", "title", "url", "number",
    "createdAt", "closedAt", "author", "labels", "commentsCount",
]


def date_range_flag(since, until):
    if until:
        return f"{since}..{until}"
    return f">={since}"


def author_login(item):
    author = item.get("author")
    if isinstance(author, dict):
        return author.get("login", "")
    return author or ""


def is_bot(item):
    author = item.get("author")
    if isinstance(author, dict):
        login = author.get("login", "")
        return (
            bool(author.get("is_bot"))
            or author.get("type") == "Bot"
            or login.endswith("[bot]")
            or login.startswith("app/")
        )
    login = author or ""
    return login.endswith("[bot]") or login.startswith("app/")


def fetch_all(author, since, until, limit, repo=None, include_bots=False):
    created = date_range_flag(since, until)
    repo_flag = [f"--repo={repo}"] if repo else []

    # Run all 5 search queries concurrently while preserving deterministic
    # priority order (author > reviewer > commented) during collection.
    queries = [
        ("issues", "issue", "author", [f"--author={author}", f"--created={created}"] + repo_flag, None),
        ("prs", "pr", "author", [f"--author={author}", f"--created={created}"] + repo_flag, None),
        ("prs", "pr", "reviewer", [f"--reviewed-by={author}", f"--created={created}"] + repo_flag, [f"-author:{author}"]),
        ("issues", "issue", "commented", [f"--commenter={author}", f"--created={created}"] + repo_flag, [f"-author:{author}"]),
        ("prs", "pr", "commented", [f"--commenter={author}", f"--created={created}"] + repo_flag, [f"-author:{author}"]),
    ]

    def run_query(q):
        kind, ctype, role, flags, qualifiers = q
        results = gh_search(kind, flags, FIELDS, limit, qualifiers=qualifiers)
        for r in results:
            r["contribution"] = ctype
            r["role"] = role
        return results

    print("Fetching authored, reviewed, and commented items in parallel...", file=sys.stderr)
    items = []
    with ThreadPoolExecutor(max_workers=len(queries)) as pool:
        for batch in pool.map(run_query, queries):
            items.extend(batch)

    # Deduplicate: commented overlaps with authored and reviewed.
    # Keep the more specific role: author > reviewer > commented.
    seen_urls = {}  # url -> role
    unique = []
    role_priority = {"author": 0, "reviewer": 1, "commented": 2}
    for item in items:
        url = item.get("url")
        role = item.get("role")
        prev = seen_urls.get(url)
        if prev is None:
            seen_urls[url] = role
            unique.append(item)
        elif role_priority.get(role, 99) < role_priority.get(prev, 99):
            # Replace with higher-priority role (shouldn't happen given fetch order, but safe)
            unique = [i for i in unique if i.get("url") != url]
            unique.append(item)
            seen_urls[url] = role
        # else: skip duplicate with lower priority

    bots_filtered = 0
    if not include_bots:
        filtered = []
        for item in unique:
            if item.get("role") != "author" and is_bot(item):
                bots_filtered += 1
            else:
                filtered.append(item)
        unique = filtered
        if bots_filtered:
            print(
                f"Filtered {bots_filtered} bot-authored item(s) (use --include-bots to show).",
                file=sys.stderr,
            )

    return unique, bots_filtered


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def repo_name(item):
    return item.get("repository", {}).get("nameWithOwner", "unknown")


def format_date(iso_str):
    if not iso_str:
        return ""
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        return dt.strftime("%Y-%m-%d")
    except (ValueError, AttributeError):
        return iso_str[:10] if iso_str else ""


def label_names(item):
    labels = item.get("labels") or []
    out = []
    for lbl in labels:
        if isinstance(lbl, dict) and lbl.get("name"):
            out.append(lbl["name"])
        elif isinstance(lbl, str):
            out.append(lbl)
    return out


def output_json(items):
    out = []
    for item in items:
        entry = dict(item)
        entry["repo"] = repo_name(entry)
        entry.pop("repository", None)
        entry["author"] = author_login(entry)
        entry["labels"] = label_names(entry)
        # Normalize Go zero-time to null
        if entry.get("closedAt", "").startswith("0001-"):
            entry["closedAt"] = None
        out.append(entry)
    json.dump(out, sys.stdout, indent=2)
    print()


def output_text(items, bots_filtered=0):
    grouped = defaultdict(lambda: defaultdict(list))
    for item in items:
        repo = repo_name(item)
        key = (item["role"], item["contribution"])
        grouped[repo][key].append(item)

    section_order = [
        ("author", "pr"), ("author", "issue"),
        ("reviewer", "pr"),
        ("commented", "pr"), ("commented", "issue"),
    ]
    section_labels = {
        ("author", "pr"): "Authored PRs",
        ("author", "issue"): "Authored Issues",
        ("reviewer", "pr"): "Reviewed PRs",
        ("commented", "pr"): "Commented PRs",
        ("commented", "issue"): "Commented Issues",
    }
    state_order = {"open": 0, "merged": 1, "closed": 2}

    # Summary
    by_role = defaultdict(int)
    by_state = defaultdict(int)
    for item in items:
        by_role[item["role"]] += 1
        by_state[item.get("state", "unknown").lower()] += 1

    print(f"Total: {len(items)}  "
          f"(authored: {by_role['author']}, reviewed: {by_role['reviewer']}, commented: {by_role['commented']})")
    print(f"State: open: {by_state.get('open', 0)}, merged: {by_state.get('merged', 0)}, closed: {by_state.get('closed', 0)}")
    if bots_filtered:
        print(f"Bots:  {bots_filtered} bot-authored item(s) hidden (use --include-bots to show)")

    # Sort repos by contribution volume descending (ties broken alphabetically)
    sorted_repos = sorted(
        grouped.keys(),
        key=lambda r: (-sum(len(v) for v in grouped[r].values()), r),
    )

    # Primary focus areas table
    total_count = len(items)
    name_width = max(len(r) for r in sorted_repos)
    print("\nFocus areas:")
    for repo in sorted_repos:
        sections = grouped[repo]
        repo_total = sum(len(v) for v in sections.values())
        pct = round(repo_total * 100 / total_count) if total_count else 0
        r_authored = len(sections.get(("author", "pr"), [])) + len(sections.get(("author", "issue"), []))
        r_reviewed = len(sections.get(("reviewer", "pr"), []))
        r_commented = len(sections.get(("commented", "pr"), [])) + len(sections.get(("commented", "issue"), []))
        print(
            f"  {repo:<{name_width}}  {repo_total:>3} ({pct:>3}%)  "
            f"authored: {r_authored}, reviewed: {r_reviewed}, commented: {r_commented}"
        )
    print()

    for repo in sorted_repos:
        sections = grouped[repo]
        repo_total = sum(len(v) for v in sections.values())
        print(f"{'=' * 78}")
        print(f"  {repo} ({repo_total})")
        print(f"{'=' * 78}")

        for key in section_order:
            if key not in sections:
                continue
            section_items = sorted(
                sections[key],
                key=lambda x: (state_order.get(x.get("state", "").lower(), 99), x.get("createdAt", "")),
            )
            print(f"\n  {section_labels[key]} ({len(section_items)})")
            print(f"  {'-' * 38}")

            for item in section_items:
                state = item.get("state", "?").upper()
                number = item.get("number", "")
                title = item.get("title", "")
                created = format_date(item.get("createdAt"))
                if len(title) > 52:
                    title = title[:51] + "…"
                print(f"    {state:<7} #{number:<6} {created}  {title}")

        print()


def output_markdown(items, bots_filtered=0):
    grouped = defaultdict(list)
    by_role = defaultdict(int)
    by_state = defaultdict(int)
    for item in items:
        grouped[repo_name(item)].append(item)
        by_role[item["role"]] += 1
        by_state[item.get("state", "unknown").lower()] += 1

    print(
        f"**Total:** {len(items)} "
        f"(authored: {by_role['author']}, reviewed: {by_role['reviewer']}, commented: {by_role['commented']}) | "
        f"**State:** open: {by_state.get('open', 0)}, merged: {by_state.get('merged', 0)}, closed: {by_state.get('closed', 0)}"
    )
    if bots_filtered:
        print(f"**Bots filtered:** {bots_filtered} bot-authored item(s)")
    print()

    sorted_repos = sorted(grouped.keys(), key=lambda r: (-len(grouped[r]), r))
    role_order = {"author": 0, "reviewer": 1, "commented": 2}
    type_order = {"pr": 0, "issue": 1}

    print("## Focus areas\n")
    print("| Repository | Total | Authored | Reviewed | Commented |")
    print("| --- | ---: | ---: | ---: | ---: |")
    for repo in sorted_repos:
        ritems = grouped[repo]
        r_a = sum(1 for x in ritems if x["role"] == "author")
        r_r = sum(1 for x in ritems if x["role"] == "reviewer")
        r_c = sum(1 for x in ritems if x["role"] == "commented")
        print(f"| {repo} | {len(ritems)} | {r_a} | {r_r} | {r_c} |")
    print()

    for repo in sorted_repos:
        ritems = sorted(
            grouped[repo],
            key=lambda x: (
                role_order.get(x["role"], 99),
                type_order.get(x["contribution"], 99),
                x.get("createdAt", ""),
            ),
        )
        print(f"## {repo} ({len(ritems)})\n")
        for item in ritems:
            role = item["role"]
            ctype = item["contribution"]
            state = item.get("state", "?").lower()
            num = item.get("number", "")
            url = item.get("url", "")
            created = format_date(item.get("createdAt"))
            cc = item.get("commentsCount", 0)
            title = item.get("title", "")
            lbls = label_names(item)
            lbl_str = f" `{', '.join(lbls)}`" if lbls else ""
            print(f"- `{role}:{ctype}:{state}` [#{num}]({url}) ({created}, c={cc}) {title}{lbl_str}")
        print()


# ---------------------------------------------------------------------------
# Inspect mode
# ---------------------------------------------------------------------------

def resolve_user(author):
    """Resolve '@me' to the authenticated GitHub login."""
    if author != "@me":
        return author
    result = subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        print(f"error: failed to resolve @me: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return result.stdout.strip()


def parse_item_ref(ref):
    """Parse a GitHub PR/issue URL or owner/repo#number into (repo, number, kind)."""
    ref = ref.strip()
    m = re.fullmatch(r"https?://github\.com/([^/]+/[^/]+)/(pull|issues)/(\d+)(?:/.*)?", ref)
    if m:
        kind = "pr" if m.group(2) == "pull" else "issue"
        return m.group(1), int(m.group(3)), kind

    m = re.fullmatch(r"([^/]+/[^/#]+)#(\d+)", ref)
    if m:
        return m.group(1), int(m.group(2)), None

    print(f"warning: unrecognized item reference: {ref}", file=sys.stderr)
    return None, None, None


def gh_json(cmd):
    """Run a gh command returning JSON; return parsed data or None on error."""
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return json.loads(result.stdout)


def inspect_pr(repo, number, user, parallel_comments=True):
    pr_cmd = [
        "gh", "pr", "view", str(number), "--repo", repo,
        "--json", "title,state,url,author,labels,body,files,closingIssuesReferences,reviews,comments",
    ]
    comments_cmd = ["gh", "api", f"repos/{repo}/pulls/{number}/comments"]

    if parallel_comments:
        with ThreadPoolExecutor(max_workers=2) as pool:
            f_pr = pool.submit(gh_json, pr_cmd)
            f_inline = pool.submit(gh_json, comments_cmd)
            pr = f_pr.result()
            inline_raw = f_inline.result() or []
    else:
        pr = gh_json(pr_cmd)
        if pr is None:
            return None
        inline_raw = gh_json(comments_cmd) or []

    if pr is None:
        return None

    user_lower = user.lower()

    # Inline review comments
    user_review_comments = [
        {"path": c.get("path", ""), "body": (c.get("body") or "").strip()}
        for c in inline_raw
        if ((c.get("user") or {}).get("login") or "").lower() == user_lower
        and (c.get("body") or "").strip()
    ]

    # Top-level reviews
    user_reviews = [
        {"state": r.get("state", ""), "body": (r.get("body") or "").strip()}
        for r in (pr.get("reviews") or [])
        if ((r.get("author") or {}).get("login") or "").lower() == user_lower
    ]

    # Conversation comments
    user_comments = [
        (c.get("body") or "").strip()
        for c in (pr.get("comments") or [])
        if ((c.get("author") or {}).get("login") or "").lower() == user_lower
        and (c.get("body") or "").strip()
    ]

    files = [
        {
            "path": f.get("path", ""),
            "additions": f.get("additions", 0),
            "deletions": f.get("deletions", 0),
        }
        for f in (pr.get("files") or [])
    ]

    closes = [
        ref["number"]
        for ref in (pr.get("closingIssuesReferences") or [])
        if isinstance(ref, dict) and "number" in ref
    ]

    return {
        "repo": repo,
        "number": number,
        "contribution": "pr",
        "url": pr.get("url", ""),
        "title": pr.get("title", ""),
        "state": (pr.get("state") or "").lower(),
        "author": author_login(pr),
        "labels": label_names(pr),
        "closes": closes,
        "files": files,
        "body": (pr.get("body") or "").strip(),
        "userReviews": user_reviews,
        "userReviewComments": user_review_comments,
        "userComments": user_comments,
    }


def inspect_issue(repo, number, user):
    issue = gh_json([
        "gh", "issue", "view", str(number), "--repo", repo,
        "--json", "title,state,url,author,labels,body,comments",
    ])
    if issue is None:
        return None

    user_lower = user.lower()
    comments = issue.get("comments") or []
    user_comments = [
        (c.get("body") or "").strip()
        for c in comments
        if ((c.get("author") or {}).get("login") or "").lower() == user_lower
        and (c.get("body") or "").strip()
    ]

    return {
        "repo": repo,
        "number": number,
        "contribution": "issue",
        "url": issue.get("url", ""),
        "title": issue.get("title", ""),
        "state": (issue.get("state") or "").lower(),
        "author": author_login(issue),
        "labels": label_names(issue),
        "commentsCount": len(comments),
        "body": (issue.get("body") or "").strip(),
        "userComments": user_comments,
    }


def _compact_text(text, max_len):
    text = re.sub(r"\s+", " ", (text or "").strip())
    if max_len and len(text) > max_len:
        return text[: max_len - 1].rstrip() + "…"
    return text


def output_inspect_markdown(results, max_body=500):
    for it in results:
        repo = it["repo"]
        num = it["number"]
        ctype = it["contribution"]
        state = it["state"]
        author = it["author"]
        title = it["title"]
        url = it["url"]
        print(f"### [{repo}#{num}]({url}) [{ctype} {state}] by {author} — {title}")

        meta = []
        if it.get("labels"):
            meta.append("Labels: " + ", ".join(it["labels"]))
        if it.get("closes"):
            meta.append("Closes: " + ", ".join(f"#{n}" for n in it["closes"]))
        if meta:
            print("- " + " | ".join(meta))

        files = it.get("files") or []
        if files:
            top = ", ".join(f"`{f['path']}` (+{f['additions']}/-{f['deletions']})" for f in files[:10])
            more = f" (+{len(files) - 10} more)" if len(files) > 10 else ""
            print(f"- **Files ({len(files)}):** {top}{more}")

        body = _compact_text(it.get("body"), max_body)
        if body:
            print(f"- **Body:** {body}")

        for r in it.get("userReviews") or []:
            rb = _compact_text(r.get("body"), max_body)
            suffix = f": {rb}" if rb else ""
            print(f"- **Review ({r['state']})**{suffix}")

        for rc in it.get("userReviewComments") or []:
            print(f"- **Inline (`{rc['path']}`):** {_compact_text(rc.get('body'), max_body)}")

        for c in it.get("userComments") or []:
            print(f"- **Comment:** {_compact_text(c, max_body)}")

        print()


def main_inspect(argv):
    parser = argparse.ArgumentParser(
        prog="gh-contributions inspect",
        description="Fetch rich details (files, linked issues, reviews, comments) for specific PRs/issues.",
        epilog="""item formats:
  https://github.com/owner/repo/pull/123   (preferred: avoids type probe)
  https://github.com/owner/repo/issues/123
  owner/repo#123
  (or pass references one per line on stdin)""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("items", nargs="*", help="PR/issue references to inspect")
    parser.add_argument("--author", default="@me",
                        help="target GitHub username for filtering reviews/comments (default: @me)")
    parser.add_argument("--format", choices=["json", "markdown"], default="json",
                        help="output format (default: json)")
    parser.add_argument("--max-body", type=int, default=500,
                        help="max chars per body/comment in markdown mode, 0 for unlimited (default: 500)")
    args = parser.parse_args(argv)

    refs = list(args.items)
    if not refs and not sys.stdin.isatty():
        refs = [line.strip() for line in sys.stdin if line.strip()]
    if not refs:
        parser.error("provide at least one PR/issue reference (as arguments or via stdin)")

    user = resolve_user(args.author)
    parsed = []
    for ref in refs:
        repo, number, kind = parse_item_ref(ref)
        if repo:
            parsed.append((repo, number, kind))

    def inspect_one(entry):
        repo, number, kind = entry
        if kind == "pr":
            data = inspect_pr(repo, number, user, parallel_comments=True)
        elif kind == "issue":
            data = inspect_issue(repo, number, user)
        else:
            data = inspect_pr(repo, number, user, parallel_comments=False) or inspect_issue(repo, number, user)
        if data is None:
            print(f"warning: failed to inspect {repo}#{number}", file=sys.stderr)
        return data

    print(f"Inspecting {len(parsed)} item(s) in parallel...", file=sys.stderr)
    results = []
    with ThreadPoolExecutor(max_workers=min(6, max(1, len(parsed)))) as pool:
        for data in pool.map(inspect_one, parsed):
            if data is not None:
                results.append(data)

    if args.format == "markdown":
        output_inspect_markdown(results, max_body=args.max_body)
    else:
        json.dump(results, sys.stdout, indent=2)
        print()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "inspect":
        main_inspect(sys.argv[2:])
        return

    parser = argparse.ArgumentParser(
        description="Fetch GitHub contributions grouped by repository, type, and state.",
        epilog="""period formats:
  YYYY-MM-DD..YYYY-MM-DD   explicit range
  YYYY-MM-DD..             since date to now
  YYYY                     full year
  YYYY-MM                  full month
  q1..q4 or YYYY-q1..q4   quarter
  last-N-days              rolling window

subcommands:
  gh-contributions inspect <owner/repo#num|url>...   fetch rich PR/issue details""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--period", default="last-365-days",
                        help="time period (default: last-365-days)")
    parser.add_argument("--author", default="@me",
                        help="GitHub username (default: @me)")
    parser.add_argument("--repo", default=None,
                        help="filter to a specific repository (owner/repo)")
    parser.add_argument("--limit", type=int, default=200,
                        help="max results per query (default: 200, max: 1000)")
    parser.add_argument("--include-bots", action="store_true",
                        help="include bot-authored PRs and issues (filtered out by default)")
    parser.add_argument("--format", choices=["text", "json", "markdown"], default=None,
                        help="output format (default: json when piped, text when interactive)")
    args = parser.parse_args()

    since, until = parse_period(args.period)
    print(f"Period: {since} .. {until or 'now'}", file=sys.stderr)

    items, bots_filtered = fetch_all(
        args.author, since, until, args.limit, args.repo, include_bots=args.include_bots
    )

    if not items:
        print("No contributions found.", file=sys.stderr)
        sys.exit(0)

    fmt = args.format
    if fmt is None:
        fmt = "text" if sys.stdout.isatty() else "json"

    if fmt == "json":
        output_json(items)
    elif fmt == "markdown":
        output_markdown(items, bots_filtered=bots_filtered)
    else:
        output_text(items, bots_filtered=bots_filtered)


if __name__ == "__main__":
    main()
