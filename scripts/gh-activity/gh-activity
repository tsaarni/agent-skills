"""


def parse_ref(ref):
    ref = ref.strip()
    m = re.fullmatch(r"https?://github\.com/([^/]+)/([^/]+)/(?:pull|issues)/(\d+)\S*", ref) or \
        re.fullmatch(r"([^/\s]+)/([^/#\s]+)#(\d+)", ref)
    return (m.group(1), m.group(2), int(m.group(3))) if m else None


def cmd_inspect(argv):
    ap = argparse.ArgumentParser(
        prog="gh-activity inspect",
        description="Details of specific PRs/issues: body, files, linked issues, reviews, review comments, comments.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""refs: https://github.com/o/r/pull/N | https://github.com/o/r/issues/N | o/r#N (or one per line on stdin)
--author=@me (default) keeps only that user's reviews/comments; --author=any shows everyone's.
examples:
  gh-activity inspect keycloak/keycloak#34826 --author=any
  gh-activity inspect --max-body=0 https://github.com/projectcontour/contour/pull/7803
""")
    ap.add_argument("refs", nargs="*")
    ap.add_argument("--author", default="@me", help="user whose reviews/comments to show: login, @me, any")
    ap.add_argument("--max-body", type=int, default=500, help="max chars per body/comment, 0 = unlimited (default 500)")
    args = ap.parse_args(argv)
    refs = args.refs or ([l for l in sys.stdin if l.strip()] if not sys.stdin.isatty() else [])
    parsed = [p for p in (parse_ref(r) for r in refs) if p]
    for r in refs:
        if not parse_ref(r):
            print(f"warning: unrecognized ref {r.strip()!r}", file=sys.stderr)
    if not parsed:
        ap.error("give PR/issue refs")
    api = Api()
    user = args.author
    if user == "@me":
        user = gh_graphql("query { viewer { login } }")["viewer"]["login"]
    user_var = None if user == "any" else user
    cut = (lambda t: one_line(t, args.max_body)) if args.max_body else (lambda t: re.sub(r"\s+", " ", t or "").strip())
    now = datetime.now(timezone.utc)
    out = []
    for i in range(0, len(parsed), DETAIL_BATCH):
        batch = parsed[i:i + DETAIL_BATCH]
        parts = [f'i{k}: repository(owner: {json.dumps(o)}, name: {json.dumps(r)}) {{ issueOrPullRequest(number: {n}) {{ {INSPECT_FIELDS} }} }}'
                 for k, (o, r, n) in enumerate(batch)]
        q = "query($user: String) { rateLimit { cost remaining } %s }" % "\n".join(parts)
        cmd = ["gh", "api", "graphql", "-f", f"query={q}"] + (["-f", f"user={user_var}"] if user_var else [])
        p = subprocess.run(cmd, capture_output=True, text=True)
        data = json.loads(p.stdout or "{}")
        if not data.get("data"):
            sys.exit(f"error: gh api graphql failed: {p.stderr.strip() or data.get('errors')}")
        api.cost += data["data"]["rateLimit"]["cost"]
        api.remaining = data["data"]["rateLimit"]["remaining"]
        for k, (o, r, n) in enumerate(batch):
            x = (data["data"].get(f"i{k}") or {}).get("issueOrPullRequest")
            if not x:
                out += ["", f"{o}/{r}#{n}: not found or no access"]
                continue
            kind = "pr" if x["__typename"] == "PullRequest" else "issue"
            state = x["state"].lower() + (" draft" if x.get("isDraft") else "")
            done = x.get("mergedAt") or x.get("closedAt")
            out += ["", f"{x['url']} {kind} {state} author={login(x['author'])} age={days(ts(x['createdAt']), now)}d"
                    + (f" base={x['baseRefName']}" if kind == "pr" else "") + (f" done={done[:10]}" if done else "")]
            out.append(f"   title: {x['title']}")
            labels = [l["name"] for l in x["labels"]["nodes"]]
            if labels:
                out.append(f"   labels: {','.join(labels)}")
            if kind == "pr":
                closes = [(f"#{c['number']}" if c["repository"]["nameWithOwner"] == f"{o}/{r}" else f"{c['repository']['nameWithOwner']}#{c['number']}")
                          for c in x["closingIssuesReferences"]["nodes"]]
                if closes:
                    out.append(f"   closes: {','.join(closes)}")
                f = x["files"]
                more = f["totalCount"] - len(f["nodes"])
                out.append(f"   files({f['totalCount']}) +{x['additions']}/-{x['deletions']}: "
                           + ",".join(f"{y['path']}(+{y['additions']}/-{y['deletions']})" for y in f["nodes"][:20])
                           + (f",…+{f['totalCount'] - 20}" if f["totalCount"] > 20 else ""))
            refs = []
            for ev in x["timelineItems"]["nodes"]:
                src = (ev or {}).get("source") or {}
                if not src.get("number"):
                    continue
                rn = src["repository"]["nameWithOwner"]
                tag = ("pr" if src["__typename"] == "PullRequest" else "issue") + f":{src['state'].lower()}" + (" closes-this" if ev.get("willCloseTarget") else "")
                refs.append(f"{'' if rn == f'{o}/{r}' else rn}#{src['number']}({tag}) {one_line(src['title'], 60)}")
            if refs:
                out.append(f"   referenced_by: {' | '.join(dict.fromkeys(refs))}")
            if x.get("body"):
                out.append(f"   body: {cut(x['body'])}")
            if kind == "pr":
                for rv in x["reviews"]["nodes"]:
                    out.append(f"   review {login(rv['author'])} {rv['state']} {rv['submittedAt'][:10]}" + (f": {cut(rv['body'])}" if rv["body"] else ""))
                    for rc in rv["comments"]["nodes"]:
                        out.append(f"     inline {rc['path']}: {cut(rc['body'])}")
            cms = [c for c in x["comments"]["nodes"] if user_var is None or login(c["author"]).lower() == user_var.lower()]
            out.append(f"   comments: total={x['comments']['totalCount']}" + ("" if user_var is None else f" by_{user_var}={len(cms)} (in last 50)"))
            for c in cms:
                out.append(f"   comment {login(c['author'])} {c['createdAt'][:10]}: {cut(c['body'])}")
    print(f"me={api.viewer or user} api_cost={api.cost} remaining={api.remaining}" + "\n".join(out))


