    author { login } labels(first: 20) { nodes { name } } body additions deletions
    closingIssuesReferences(first: 10) { nodes { number repository { nameWithOwner } } }
    files(first: 100) { totalCount nodes { path additions deletions } }
    reviews(author: $user, last: 30) { nodes { author { login } state submittedAt body
      comments(first: 30) { nodes { path body } } } }
    comments(last: 50) { totalCount nodes { author { __typename login } createdAt body } }
    timelineItems(itemTypes: [CROSS_REFERENCED_EVENT], last: 20) { nodes { ... on CrossReferencedEvent { willCloseTarget
      source { __typename ... on PullRequest { number title state repository { nameWithOwner } }
                         ... on Issue { number title state repository { nameWithOwner } } } } } } }
  ... on Issue { url number title state createdAt closedAt
