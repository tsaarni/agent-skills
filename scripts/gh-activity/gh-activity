#!/usr/bin/env python3
"""
gh-activity: GitHub activity for AI agents (compact text output). Requires authenticated gh CLI.

  status    current PR status: CI, mergeability, reviews, threads, linked issues, whose turn and how long;
            --mine (waiting on me), --stats (repo-level counts)
  history   a user's contributions over a period (PRs + issues; author / reviewer / commented)
  inspect   rich details of specific PRs/issues (body, files, reviews, inline review comments, comments)

GraphQL search with light fields + batched node lookups only where needed (few API points).
"""

import argparse
import json
import re
import subprocess
import sys
import time
from collections import Counter
from datetime import date, datetime, timedelta, timezone

PAGE_SIZE = 25
SEARCH_CAP = 1000  # GitHub search returns at most 1000 results

PR_FIELDS = """
      id url number title state createdAt updatedAt mergedAt closedAt isDraft
      author { __typename login }
      baseRefName
      mergeable mergeStateStatus reviewDecision
      additions deletions changedFiles
      labels(first: 10) { nodes { name } }
      repository { nameWithOwner squashMergeAllowed mergeCommitAllowed rebaseMergeAllowed }
      files(first: 30) { nodes { path } }
      body @include(if: $body)
      reviewRequests(first: 10) { nodes { asCodeOwner requestedReviewer {
        __typename ... on User { login } ... on Team { slug } ... on Bot { login } ... on Mannequin { login } } } }
      reviewThreads(last: 20) { totalCount nodes { isResolved isOutdated } }
      closingIssuesReferences(first: 10) { nodes { number state url repository { nameWithOwner } } }
      latestReviews(first: 20) { nodes { author { __typename login } state submittedAt } }
      comments(last: $comments) { nodes { author { __typename login } body createdAt } }
      commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state
        contexts(first: 0) { totalCount
          checkRunCountsByState { state count } statusContextCountsByState { state count } } } } } }
"""

QUERY = """
query($q: String!, $type: SearchType!, $first: Int!, $after: String, $body: Boolean!, $comments: Int!) {
  rateLimit { cost remaining resetAt }
  viewer { login }
  search(query: $q, type: $type, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest { %s } }
  }
}
""" % PR_FIELDS

# Second phase, only for PRs that need it (fetched by node id, batched): keeps the search cheap and small.
CHECKS_QUERY = """
query($ids: [ID!]!) {
  rateLimit { cost remaining }
  nodes(ids: $ids) { ... on PullRequest { id commits(last: 1) { nodes { commit { statusCheckRollup {
    contexts(first: 100) { nodes {
      ... on CheckRun { name conclusion status }
      ... on StatusContext { context state } } } } } } } } }
}
"""
THREADS_QUERY = """
query($ids: [ID!]!) {
  rateLimit { cost remaining }
  nodes(ids: $ids) { ... on PullRequest { id reviewThreads(last: 20) { nodes {
    comments(last: 1) { nodes { author { __typename login } createdAt } } } } } }
}
"""
URLS_QUERY = """
query($q: String!, $after: String) {
  rateLimit { cost remaining }
  viewer { login }
  search(query: $q, type: ISSUE, first: 100, after: $after) {
    issueCount pageInfo { hasNextPage endCursor } nodes { ... on PullRequest { url } } }
}
"""
MERGEABLE_QUERY = """
query($ids: [ID!]!) {
  rateLimit { cost remaining }
  nodes(ids: $ids) { ... on PullRequest { id mergeable mergeStateStatus } }
}
"""
DETAIL_BATCH = 10

FAILED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}
PENDING = {"PENDING", "QUEUED", "IN_PROGRESS", "EXPECTED", "WAITING", "REQUESTED"}
BOT_LOGINS = {"copilot-pull-request-reviewer", "github-actions", "dependabot", "renovate", "codecov", "netlify"}
BOT_COMMAND = re.compile(r"^\s*@(dependabot|renovate|mergify|k8s-ci-robot)\b|^\s*/\w+", re.I)  # bot commands, not review feedback
COMMENTS_FETCH = 10
LABEL_CHECK = re.compile(r"label|release.?note|changelog", re.I)  # needs triage permission: maintainers' job
DCO_CHECK = re.compile(r"\bDCO\b|sign.?off", re.I)  # author must sign off commits  # fetch more than shown so bot noise doesn't push human activity out of the window


# ---------------------------------------------------------------------------
# GitHub access
# ---------------------------------------------------------------------------

def gh_graphql(query, variables=None, _retried=False):
    cmd = ["gh", "api", "graphql", "-f", f"query={query}"]
    for k, v in (variables or {}).items():
        if v is None:
            continue
        if isinstance(v, list):
            cmd += [x for item in v for x in ("-f", f"{k}[]={item}")]
        elif isinstance(v, bool):
            cmd += ["-F", f"{k}={'true' if v else 'false'}"]
        elif isinstance(v, int):
            cmd += ["-F", f"{k}={v}"]
        else:
            cmd += ["-f", f"{k}={v}"]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        err = p.stderr.strip()
        if re.search(r"HTTP 50[234]|timeout|timed out|unexpected end of JSON", err, re.I):
            raise TimeoutError(err)
        if not _retried and re.search(r"secondary rate limit", err, re.I):
            print("note: secondary rate limit, waiting 60s and retrying once", file=sys.stderr)
            time.sleep(60)
            return gh_graphql(query, variables, _retried=True)
        sys.exit(f"error: gh api graphql failed: {err}")
    data = json.loads(p.stdout)
    if data.get("errors"):
        sys.exit(f"error: {data['errors']}")
    return data["data"]


class Api:
    def __init__(self):
        self.cost = 0
        self.remaining = None
        self.viewer = None

    def search(self, q, limit, body, comments, advanced=False):
        """Paginated PR search. Returns (issueCount, nodes)."""
        nodes, after, total, page = [], None, 0, PAGE_SIZE
        while len(nodes) < limit:
            try:
                d = gh_graphql(QUERY, {"q": q, "type": "ISSUE_ADVANCED" if advanced else "ISSUE",
                                       "first": min(page, limit - len(nodes)), "after": after,
                                       "body": body, "comments": max(comments, COMMENTS_FETCH)})
            except TimeoutError as e:
                # heavy pages (many checks/files per PR) time out server-side: shrink and retry
                if page <= 5:
                    sys.exit(f"error: gh api graphql failed: {e}")
                page //= 2
                print(f"note: server timeout, retrying with page size {page}", file=sys.stderr)
                continue
            self._account(d)
            s = d["search"]
            total = s["issueCount"]
            nodes += [n for n in s["nodes"] if n]
            if not s["pageInfo"]["hasNextPage"]:
                break
            after = s["pageInfo"]["endCursor"]
        return total, nodes

    def enrich(self, nodes):
        """Fetch check names for PRs with failing/pending CI and last thread replies for PRs with threads."""
        def counts_of(n):
            ctx = ((n["commits"]["nodes"] or [{}])[0].get("commit") or {}).get("statusCheckRollup") or {}
            ctx = ctx.get("contexts") or {}
            cnt = Counter()  # sum: check runs and status contexts share state names (FAILURE, PENDING…)
            for x in ctx.get("checkRunCountsByState", []) + ctx.get("statusContextCountsByState", []):
                cnt[x["state"]] += x["count"]
            return cnt
        by_id = {n["id"]: n for n in nodes}
        # GitHub computes mergeability lazily: first query on old PRs returns UNKNOWN; re-ask once
        unknown = [n["id"] for n in nodes if n["state"] == "OPEN" and n["mergeable"] == "UNKNOWN"]
        if unknown:
            time.sleep(3)
            for i in range(0, len(unknown), 50):
                d = gh_graphql(MERGEABLE_QUERY, {"ids": unknown[i:i + 50]})
                self.cost += d["rateLimit"]["cost"]
                for x in d["nodes"]:
                    if x:
                        by_id[x["id"]].update(mergeable=x["mergeable"], mergeStateStatus=x["mergeStateStatus"])
        need_checks = [n["id"] for n in nodes if any(counts_of(n).get(st) for st in FAILED | PENDING)]
        need_threads = [n["id"] for n in nodes if n["reviewThreads"]["totalCount"]]
        for query, ids, key in ((CHECKS_QUERY, need_checks, "checks"), (THREADS_QUERY, need_threads, "threads")):
            for i in range(0, len(ids), DETAIL_BATCH):
                d = gh_graphql(query, {"ids": ids[i:i + DETAIL_BATCH]})
                self.cost += d["rateLimit"]["cost"]
                self.remaining = d["rateLimit"]["remaining"]
                for x in d["nodes"]:
                    if not x:
                        continue
                    if key == "checks":
                        c = x["commits"]["nodes"][0]["commit"]["statusCheckRollup"] if x["commits"]["nodes"] else None
                        by_id[x["id"]]["_check_nodes"] = ((c or {}).get("contexts") or {}).get("nodes", [])
                    else:
                        by_id[x["id"]]["_thread_last"] = [cm for t in x["reviewThreads"]["nodes"] for cm in t["comments"]["nodes"]]

    def urls(self, q, limit):
        """Light search returning only PR urls."""
        urls, after = set(), None
        while len(urls) < limit:
            d = gh_graphql(URLS_QUERY, {"q": q, "after": after})
            self._account(d)
            urls |= {n["url"] for n in d["search"]["nodes"] if n}
            if not d["search"]["pageInfo"]["hasNextPage"]:
                break
            after = d["search"]["pageInfo"]["endCursor"]
        return d["search"]["issueCount"], urls

    def counts(self, queries, advanced=False):
        """{name: query} -> {name: issueCount}, one aliased request."""
        t = "ISSUE_ADVANCED" if advanced else "ISSUE"
        parts = [f'{k}: search(query: {json.dumps(q)}, type: {t}, first: 0) {{ issueCount }}' for k, q in queries.items()]
        d = gh_graphql("query { rateLimit { cost remaining } viewer { login } %s }" % "\n".join(parts))
        self._account(d)
        return {k: d[k]["issueCount"] for k in queries}

    def _account(self, d):
        self.cost += d["rateLimit"]["cost"]
        self.remaining = d["rateLimit"]["remaining"]
        self.viewer = d["viewer"]["login"]


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def parse_since(value):
    """YYYY-MM-DD or Nd (N days ago) -> YYYY-MM-DD."""
    m = re.fullmatch(r"(\d+)d", value)
    if m:
        return str(date.today() - timedelta(days=int(m.group(1))))
    try:
        return str(date.fromisoformat(value))
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid --since {value!r}: use YYYY-MM-DD or Nd")


def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None


def days(t, now):
    return (now - t).days if t else None


def one_line(text, n):
    text = re.sub(r"<[^>]+>", " ", text or "")
    text = re.sub(r"\s+", " ", text).strip()
    return text if len(text) <= n else text[: n - 1] + "…"


def bump_body(body):
    """Dependabot/Renovate PR body -> summary + release notes (changelog if no notes); drop commits, badges, command help."""
    if not body or not re.search(r"<summary>(Release notes|Changelog|Commits)</summary>", body):
        return body
    parts, pos, prev = [], 0, None
    for m in re.finditer(r"<details>\s*<summary>(.*?)</summary>(.*?)</details>", body, re.S):
        parts.append(("text", body[pos:m.start()]))
        parts.append((m.group(1).strip(), m.group(2)))
        pos = m.end()
    parts.append(("text", body[pos:]))
    out = []
    for kind, txt in parts:
        if kind == "text":
            txt = re.split(r"\n\[!\[Dependabot compatibility|\nDependabot will resolve|\n---\s*\n", txt)[0]
            if txt.strip():  # only real text between blocks starts a new section (grouped PRs)
                out.append(txt)
                prev = None
        elif kind == "Release notes" or (kind == "Changelog" and prev != "Release notes"):
            # drop upstream's own bot bumps and contributor lists; then tags and the "Sourced from …" line
            txt = re.sub(r"<li>(?:(?!</li>).)*?(dependabot|renovate|\[bot\]|first contribution)(?:(?!</li>).)*?</li>", "", txt, flags=re.S | re.I)
            txt = re.sub(r"<h\d>\s*New Contributors\s*</h\d>", "", txt, flags=re.I)
            txt = re.sub(r"<[^>]+>", " ", txt)
            txt = re.sub(r"^\s*Sourced from [^\n]*?(releases|changelog)\s*\.?", "", txt, count=1, flags=re.I)
            out.append(f"{kind}: {txt}")
            prev = kind
    return "\n".join(out)


def login(a):
    return (a or {}).get("login") or "ghost"


def is_bot(a):
    return not a or a.get("__typename") == "Bot" or a.get("login", "").endswith("[bot]") or a.get("login") in BOT_LOGINS


def base_filters(args):
    q = [f"repo:{r}" for r in args.repos]
    if args.author:
        q.append(f"author:{args.author}")
    if args.no_draft:
        q.append("draft:false")
    return q


def build_query(args, extra=()):
    q = ["is:pr"]
    if args.state in ("open", "closed"):
        q.append(f"is:{args.state}")
    elif args.state == "merged":
        q.append("is:merged")
    if args.since:  # merged/closed: filter by when it happened, not creation
        q.append(f"{ {'merged': 'merged', 'closed': 'closed'}.get(args.state, 'created') }:>={args.since}")
    q += base_filters(args) + list(extra)
    # sort server-side so --limit keeps the right PRs (default search order is best-match, arbitrary)
    q.append({"age": "sort:created-asc", "waiting": "sort:updated-asc"}.get(args.sort, "sort:created-desc"))
    return " ".join(q)


