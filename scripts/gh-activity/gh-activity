# Analysis
# ---------------------------------------------------------------------------

def analyze(n, now):
    """Derive check summary, reviewers and whose turn it is."""
    c = n["commits"]["nodes"][0]["commit"] if n["commits"]["nodes"] else {}
    roll = c.get("statusCheckRollup") or {}
    ctx = roll.get("contexts") or {}
    cnt = Counter()
    for x in ctx.get("checkRunCountsByState", []) + ctx.get("statusContextCountsByState", []):
        cnt[x["state"]] += x["count"]
    names = [((x.get("name") or x.get("context")), (x.get("conclusion") or x.get("state") or x.get("status")))
             for x in n.get("_check_nodes", []) if x]
    a = {
        "checks_total": ctx.get("totalCount", 0),
        "ci": roll.get("state", "NONE"),
        "n_failed": sum(cnt[st] for st in FAILED),
        "n_pending": sum(cnt[st] for st in PENDING),
        "failed": [nm for nm, st in names if st in FAILED],
        "pending": [nm for nm, st in names if st in PENDING],
        "skipped": cnt["SKIPPED"],
        "passed": cnt["SUCCESS"],
        "last_commit": ts(c.get("committedDate")),
    }
    author = login(n["author"])
    a["author"] = author

    reviews = {"APPROVED": [], "CHANGES_REQUESTED": [], "COMMENTED": [], "DISMISSED": []}
    human_reviews = []
    for r in n["latestReviews"]["nodes"]:
        reviews.setdefault(r["state"], []).append(login(r["author"]))
        if not is_bot(r["author"]) and login(r["author"]) != author:
            human_reviews.append((ts(r["submittedAt"]), login(r["author"]), r["state"]))
    requested, requested_users = [], []
    for r in n["reviewRequests"]["nodes"]:
        x = r["requestedReviewer"] or {}
        name = x.get("login") or (f"@{n['repository']['nameWithOwner'].split('/')[0]}/{x['slug']}" if x.get("slug") else "hidden")
        if x.get("__typename") == "User":
            requested_users.append(name)
        requested.append(name + ("(codeowner)" if r["asCodeOwner"] else ""))
    a.update(reviews=reviews, requested=requested, requested_users=requested_users)

    # last activity by author (commits, comments, review-thread replies) vs by other humans (reviews, comments, thread replies)
    human_comments = [cm for cm in n["comments"]["nodes"] if not is_bot(cm["author"]) and not BOT_COMMAND.match(cm["body"] or "")]
    thread_last = [cm for cm in n.get("_thread_last", []) if not is_bot(cm["author"])]
    author_times = [a["last_commit"]] + [ts(cm["createdAt"]) for cm in human_comments + thread_last if login(cm["author"]) == author]
    other = [(t, who, st) for t, who, st in human_reviews] + [
        (ts(cm["createdAt"]), login(cm["author"]), "COMMENT") for cm in human_comments + thread_last
        if login(cm["author"]) != author]
    last_author = max((t for t in author_times if t), default=ts(n["createdAt"]))
    last_other_t, last_other_who, last_other_kind = max(other, default=(None, None, None), key=lambda x: x[0])
    a["last_author"], a["last_other"], a["last_other_who"] = last_author, last_other_t, last_other_who

    ci_bad = a["ci"] in ("FAILURE", "ERROR")
    real_failed = [f for f in a["failed"] if not LABEL_CHECK.search(f) and not DCO_CHECK.search(f)]
    a["policy"] = []
    if ci_bad and a["failed"] and not real_failed and len(a["failed"]) == a["n_failed"]:
        # only policy checks fail: not a broken build
        if any(LABEL_CHECK.search(f) for f in a["failed"]):
            a["policy"].append("label_missing")
        ci_bad = False
        dco = any(DCO_CHECK.search(f) for f in a["failed"])
    else:
        dco = False
    if n["state"] != "OPEN":
        done = ts(n["mergedAt"] or n["closedAt"])
        turn, why, since = "none", n["state"].lower(), done
    elif n["isDraft"]:
        turn, why, since = "author", "draft", last_author
    elif n["mergeable"] == "CONFLICTING":
        turn, why, since = "author", "conflicts", max(filter(None, [last_author, last_other_t]))
    elif ci_bad:
        turn, why, since = "author", "ci_failed", a["last_commit"] or last_author
    elif dco:
        turn, why, since = "author", "dco_missing", a["last_commit"] or last_author
    elif a["ci"] in ("PENDING", "EXPECTED"):
        turn, why, since = "ci", "ci_running", a["last_commit"] or last_author
    elif n["reviewDecision"] == "CHANGES_REQUESTED" and last_other_t and last_other_t > last_author:
        turn, why, since = "author", "changes_requested", last_other_t
    elif n["reviewDecision"] == "APPROVED" or (n["reviewDecision"] is None and n["mergeStateStatus"] == "CLEAN"):
        approved = [t for t, _, st in human_reviews if st == "APPROVED"]
        turn, why, since = "merge", "approved" if approved else "ready", max(approved + [a["last_commit"] or last_author])
    elif last_other_t and last_other_t > last_author and last_other_kind == "APPROVED":
        # approved by someone, but more approvals (e.g. code owners) still required
        turn, why, since = "reviewers", f"approved_by_{last_other_who}_needs_more", last_other_t
    elif last_other_t and last_other_t > last_author:
        turn, why, since = "author", f"feedback_from_{last_other_who}", last_other_t
    else:
        turn, why, since = "reviewers", "awaiting_review" if not human_reviews else "awaiting_re-review", last_author
    if turn == "author" and is_bot(n["author"]):
        # bot can't fix CI/conflicts/feedback itself: maintainers act (rebase/recreate/fix/close)
        turn, why = "maintainers", f"{why}(bot_pr)"
    a["turn"], a["why"], a["since"] = turn, why, since
    a["waiting_days"] = days(since, now)
    return a


def turn_who(n, a):
    if a["turn"] == "author":
        return a["author"]
    if a["turn"] == "reviewers":
        return ",".join(a["requested"]) or "maintainers"
    if a["turn"] in ("merge", "maintainers"):
        return "maintainers"
    return ""


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def render_pr(i, n, a, args, now, out):
    flags = ["draft"] if n["isDraft"] else []
    if "mine" in a:
        flags.append(f"mine={a['mine']}")
    out.append("")
    if n["state"] != "OPEN":
        done = n["mergedAt"] or n["closedAt"]
        flags.append(f"state={n['state'].lower()}@{done[:10]} open_for={(ts(done) - ts(n['createdAt'])).days}d")
    out.append(f"{i}. {n['url']} age={days(ts(n['createdAt']), now)}d author={a['author']}"
               f" base={n['baseRefName']}" + (f" {' '.join(flags)}" if flags else ""))
    out.append(f"   title: {n['title']}")
    who = turn_who(n, a)
    if n["state"] == "OPEN":
        out.append(f"   turn={a['turn']}" + (f"({who})" if who and who != a["turn"] else "") + f" reason={a['why']} waiting={a['waiting_days']}d"
                   + (f" policy={','.join(a['policy'])}" if a["policy"] else ""))
    labels = [l["name"] for l in n["labels"]["nodes"]]
    if labels:
        out.append(f"   labels: {','.join(labels)}")
    unlisted = a["n_failed"] + a["n_pending"] - len(a["failed"]) - len(a["pending"])
    out.append(f"   ci={a['ci']} checks={a['checks_total']} passed={a['passed']} failed={a['n_failed']}[{','.join(a['failed'])}]"
               f" pending={a['n_pending']}[{','.join(a['pending'])}] skipped={a['skipped']}"
               + (f" ({unlisted} not listed, >100 checks)" if unlisted > 0 else ""))
    out.append(f"   mergeable={n['mergeable']} merge_state={n['mergeStateStatus']} review={n['reviewDecision'] or '-'}")
    rv = a["reviews"]
    if any(rv.values()) or a["requested"]:
        out.append(f"   reviews: approved=[{','.join(rv['APPROVED'])}] changes=[{','.join(rv['CHANGES_REQUESTED'])}]"
                   f" commented=[{','.join(rv['COMMENTED'])}] requested=[{','.join(a['requested'])}]")
    files = [f["path"] for f in n["files"]["nodes"]]
    more = n["changedFiles"] - len(files)
    out.append(f"   files({n['changedFiles']}) +{n['additions']}/-{n['deletions']}: {','.join(files)}" + (f",…+{more}" if more > 0 else ""))
    th = n["reviewThreads"]
    unresolved = [t for t in th["nodes"] if not t["isResolved"]]
    act = [f"last_activity={days(ts(n['updatedAt']), now)}d"]
    if a["last_commit"]:
        act.append(f"last_commit={a['last_commit']:%Y-%m-%d}")
    act.append(f"last_author_activity={a['last_author']:%Y-%m-%d}")
    if a["last_other"]:
        act.append(f"last_other_activity={a['last_other']:%Y-%m-%d}({a['last_other_who']})")
    out.append("   " + " ".join(act))
    if th["totalCount"]:
        seen_t = len(th["nodes"])
        out.append(f"   threads: unresolved={len(unresolved)} (outdated={sum(t['isOutdated'] for t in unresolved)})"
                   f" resolved={seen_t - len(unresolved)}" + (f" (last {seen_t} of {th['totalCount']})" if th["totalCount"] > seen_t else ""))
    issues = n["closingIssuesReferences"]["nodes"]
    if issues:
        own = n["repository"]["nameWithOwner"]
        out.append("   closes: " + ",".join(
            (f"#{i['number']}" if i["repository"]["nameWithOwner"] == own else f"{i['repository']['nameWithOwner']}#{i['number']}")
            + ("" if i["state"] == "OPEN" else f"({i['state'].lower()})") for i in issues))
    for cm in [c for c in n["comments"]["nodes"] if not is_bot(c["author"])][-args.comments:] if args.comments else []:
        out.append(f"   comment {login(cm['author'])} {cm['createdAt'][:10]}: {one_line(cm['body'], 120)}")
    if args.body:
        body = bump_body(n.get("body")) if is_bot(n["author"]) else n.get("body")
        out.append(f"   body: {one_line(body, args.body)}")


def merge_methods(nodes):
    repos = {}
    for n in nodes:
        r = n["repository"]
        repos[r["nameWithOwner"]] = ",".join(m for m, ok in (
            ("squash", r["squashMergeAllowed"]), ("merge", r["mergeCommitAllowed"]),
            ("rebase", r["rebaseMergeAllowed"])) if ok)
    return [f"repo {k} merge_methods={v}" for k, v in sorted(repos.items())]


def repo_stats(api, args):
    base = " ".join(["is:pr"] + [f"repo:{r}" for r in args.repos] + ([f"author:{args.author}"] if args.author else []))
    d7, d30, d90 = (str(date.today() - timedelta(days=x)) for x in (7, 30, 90))
    q = {
        "open": "is:open", "draft": "is:open draft:true",
        "review_none": "is:open draft:false review:none", "review_required": "is:open draft:false review:required",
        "approved": "is:open draft:false review:approved", "changes_requested": "is:open draft:false review:changes_requested",
        "ci_failing": "is:open status:failure", "ci_pending": "is:open status:pending",
        "idle_30d": f"is:open updated:<{d30}", "idle_90d": f"is:open updated:<{d90}",
        "opened_7d": f"created:>={d7}", "opened_30d": f"created:>={d30}",
        "merged_7d": f"is:merged merged:>={d7}", "merged_30d": f"is:merged merged:>={d30}",
        "closed_unmerged_30d": f"is:closed is:unmerged closed:>={d30}",
    }
    c = api.counts({k: f"{base} {v}" for k, v in q.items()})
    return [
        f"stats scope: {base} (repo/author only; --since/--state/--no-draft not applied; review counts exclude drafts)",
        f"stats open={c['open']} draft={c['draft']} approved={c['approved']} changes_requested={c['changes_requested']}"
        f" review_required={c['review_required']} no_review_yet={c['review_none']}",
        f"stats ci_failing={c['ci_failing']} ci_pending={c['ci_pending']} idle_over_30d={c['idle_30d']} (of which over_90d={c['idle_90d']})",
        f"stats last_7d: opened={c['opened_7d']} merged={c['merged_7d']}"
        f" | last_30d: opened={c['opened_30d']} merged={c['merged_30d']} closed_unmerged={c['closed_unmerged_30d']}"
        f" net_backlog={c['opened_30d'] - c['merged_30d'] - c['closed_unmerged_30d']:+d}",
    ]


def fetched_stats(items):
    if not items:
        return []
    out = []
    merged = sorted((ts(n["mergedAt"]) - ts(n["createdAt"])).total_seconds() / 86400 for n, _ in items if n["mergedAt"])
    if merged:
        pct = lambda p: merged[min(len(merged) - 1, int(p * len(merged)))]
        out.append(f"fetched time_to_merge: n={len(merged)} median={pct(0.5):.1f}d p90={pct(0.9):.1f}d max={merged[-1]:.1f}d")
    items = [(n, a) for n, a in items if n["state"] == "OPEN"]
    if not items:
        return out
    turns = Counter(a["turn"] for _, a in items)
    out.append("fetched turn: " + " ".join(f"{k}={v}" for k, v in turns.most_common()))
    buckets = Counter()
    for _, a in items:
        w = a["waiting_days"] or 0
        buckets["<7d" if w < 7 else "7-30d" if w < 30 else "30-90d" if w < 90 else ">90d"] += 1
    out.append("fetched waiting: " + " ".join(f"{k}={buckets[k]}" for k in ("<7d", "7-30d", "30-90d", ">90d")))
    fails = Counter(f for _, a in items for f in set(a["failed"]))
    common = [(k, v) for k, v in fails.most_common(8) if v >= 2]
    if common:
        out.append("fetched checks failing on >=2 PRs (flaky/infra suspects): " + ", ".join(f"{k}={v}" for k, v in common))
    authors = Counter(a["author"] for _, a in items)
    out.append("fetched top authors: " + ", ".join(f"{k}={v}" for k, v in authors.most_common(5)))
    revs = Counter(r for _, a in items for st in ("APPROVED", "CHANGES_REQUESTED", "COMMENTED") for r in a["reviews"][st]
                   if r not in BOT_LOGINS)
    if revs:
        out.append("fetched top reviewers: " + ", ".join(f"{k}={v}" for k, v in revs.most_common(5)))
    return out


