# history: contributions of a user over a period (PRs + issues, role-tagged)
# ---------------------------------------------------------------------------

REPO_RE = re.compile(r"[\w.-]+/[\w.-]+")

HISTORY_QUERY = """
query($q: String!, $first: Int!, $after: String, $user: String!, $acts: Boolean!) {
  rateLimit { cost remaining }
  viewer { login }
  search(query: $q, type: ISSUE_ADVANCED, first: $first, after: $after) {
    issueCount
    pageInfo { hasNextPage endCursor }
    nodes { __typename
      ... on PullRequest { url number title state createdAt closedAt mergedAt
        author { __typename login } labels(first: 10) { nodes { name } } comments { totalCount }
        repository { nameWithOwner } reviews(author: $user, first: 0) { totalCount }
        myReviews: reviews(author: $user, last: 5) @include(if: $acts) { nodes { submittedAt } }
        lastComments: comments(last: 30) @include(if: $acts) { nodes { author { login } createdAt } } }
      ... on Issue { url number title state createdAt closedAt
        author { __typename login } labels(first: 10) { nodes { name } } comments { totalCount }
        repository { nameWithOwner }
        lastComments: comments(last: 30) @include(if: $acts) { nodes { author { login } createdAt } } }
    }
  }
}
"""


def parse_period(value):
    """-> (since, until|None) as YYYY-MM-DD. Formats: A..B, A.., YYYY, YYYY-MM, [YYYY-]qN, last-N-days, Nd, YYYY-MM-DD."""
    today = date.today()
    if ".." in value:
        a, b = value.split("..", 1)
        return a, (b or None)
    m = re.fullmatch(r"(?:(\d{4})-)?[qQ]([1-4])", value)
    if m:
        y, q = int(m.group(1) or today.year), int(m.group(2))
        start = date(y, 3 * q - 2, 1)
        end = date(y + (q == 4), 1 if q == 4 else 3 * q + 1, 1) - timedelta(days=1)
        return str(start), str(end)
    if re.fullmatch(r"\d{4}", value):
        return f"{value}-01-01", f"{value}-12-31"
    m = re.fullmatch(r"(\d{4})-(\d{2})", value)
    if m:
        y, mo = int(m.group(1)), int(m.group(2))
        end = date(y + (mo == 12), 1 if mo == 12 else mo + 1, 1) - timedelta(days=1)
        return f"{value}-01", str(end)
    m = re.fullmatch(r"last-(\d+)-days|(\d+)d", value)
    if m:
        return str(today - timedelta(days=int(m.group(1) or m.group(2)))), None
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
        return value, None
    raise argparse.ArgumentTypeError(f"invalid period {value!r}")


def split_ranges(api, base, since, until, field="created"):
    """Split [since, until] until each sub-range matches <= SEARCH_CAP items (search hard cap)."""
    d0, d1 = date.fromisoformat(since), date.fromisoformat(until)
    stack, out = [(d0, d1)], []
    while stack:
        a, b = stack.pop()
        q = f"{base} {field}:{a}..{b}"
        c = api.counts({"c": q}, advanced=True)["c"]
        if c > SEARCH_CAP and a < b:
            mid = a + (b - a) // 2
            stack += [(mid + timedelta(days=1), b), (a, mid)]
        else:
            out.append((q, c))
    return out


def cmd_history(argv):
    ap = argparse.ArgumentParser(
        prog="gh-activity history",
        description="User's GitHub contributions over a period: PRs and issues authored, PRs reviewed, items commented.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""period: A..B | A.. | YYYY | YYYY-MM | [YYYY-]q1..q4 | last-N-days | Nd | YYYY-MM-DD
role: author > reviewer > commented (highest applies). Bot-authored non-own items hidden unless --include-bots.
examples:
  gh-activity history                                   # @me, last 365 days
  gh-activity history --period=q3 projectcontour/contour
  gh-activity history --author=<login> --period=2026-09
""")
    ap.add_argument("repos", nargs="*", metavar="owner/repo")
    ap.add_argument("--author", default="@me", help="GitHub user (default @me)")
    ap.add_argument("--period", default="last-365-days", help="default last-365-days")
    ap.add_argument("--type", choices=["all", "pr", "issue"], default="all")
    ap.add_argument("--date", choices=["created", "activity"], default="created",
                    help="created (default): items created in period. activity: items where the user authored, reviewed "
                         "or commented within the period, incl. older items (last 30 comments / 5 reviews checked)")
    ap.add_argument("--role", choices=["all", "author", "reviewer", "commented"], default="all")
    ap.add_argument("--include-bots", action="store_true", help="include bot-authored items the user only reviewed/commented")
    ap.add_argument("--limit", type=int, default=3000, help="max items (default 3000)")
    args = ap.parse_args(argv)
    for r in args.repos:
        if not REPO_RE.fullmatch(r):
            ap.error(f"invalid repo {r!r}, expected owner/repo")
    try:
        since, until = parse_period(args.period)
    except argparse.ArgumentTypeError as e:
        ap.error(str(e))
    until = until or str(date.today())

    api = Api()
    user = args.author
    if user == "@me":
        user = gh_graphql("query { viewer { login } }")["viewer"]["login"]
    roles = {"author": [f"author:{user}"], "reviewer": [f"reviewed-by:{user}"], "commented": [f"commenter:{user}"]}
    who = roles[args.role] if args.role != "all" else [x for v in roles.values() for x in v]
    base = ["(" + " OR ".join(who) + ")"]
    if args.type != "all":
        base.append(f"is:{args.type}")
    if args.repos:
        base.append("(" + " OR ".join(f"repo:{r}" for r in args.repos) + ")")
    base = " ".join(base)

    ranges = split_ranges(api, base, since, until, "updated" if args.date == "activity" else "created")
    nodes = []
    for q, c in sorted(ranges):
        after = None
        while c and len(nodes) < args.limit:
            d = gh_graphql(HISTORY_QUERY, {"q": q, "first": 50 if args.date == "activity" else 100, "after": after,
                                           "user": user, "acts": args.date == "activity"})
            api._account(d)
            nodes += [n for n in d["search"]["nodes"] if n and n.get("url")]
            if not d["search"]["pageInfo"]["hasNextPage"]:
                break
            after = d["search"]["pageInfo"]["endCursor"]

    ul = user.lower()
    lo, hi = datetime.fromisoformat(since + "T00:00:00+00:00"), datetime.fromisoformat(until + "T23:59:59+00:00")
    items, bots, outside = [], 0, 0
    for n in {n["url"]: n for n in nodes}.values():
        if args.date == "activity":
            acts = [ts(n["createdAt"])] if login(n["author"]).lower() == ul else []
            acts += [ts(r["submittedAt"]) for r in (n.get("myReviews") or {}).get("nodes", []) if r["submittedAt"]]
            acts += [ts(c["createdAt"]) for c in n["lastComments"]["nodes"] if login(c["author"]).lower() == ul]
            acts = [t for t in acts if lo <= t <= hi]
            if not acts:
                outside += 1  # updated in period, but not by the user
                continue
            n["_acted"] = max(acts)
        kind = "pr" if n["__typename"] == "PullRequest" else "issue"
        if login(n["author"]).lower() == ul:
            role = "author"
        elif kind == "pr" and n["reviews"]["totalCount"]:
            role = "reviewer"
        else:
            role = "commented"
        if args.role != "all" and role != args.role:
            continue
        if role != "author" and is_bot(n["author"]) and not args.include_bots:
            bots += 1
            continue
        items.append((n, kind, role))

    total = sum(c for _, c in ranges)
    out = [f"query: {base} {'updated' if args.date == 'activity' else 'created'}:{since}..{until}"
           + (" + user's own action in period" if args.date == "activity" else ""),
           f"user={user} matched={total} shown={len(items)}" + (f" ranges={len(ranges)}" if len(ranges) > 1 else "")
           + (" (truncated, raise --limit)" if len(nodes) < total else "") + f" bots_hidden={bots}"
           + (f" updated_by_others_only={outside}" if args.date == "activity" else ""),
           f"api_cost={api.cost} remaining={api.remaining}"]
    rc = Counter(r for _, _, r in items)
    tc = Counter(k for _, k, _ in items)
    sc = Counter(n["state"].lower() for n, _, _ in items)
    out.append(f"totals: authored={rc['author']} reviewed={rc['reviewer']} commented={rc['commented']}"
               f" | pr={tc['pr']} issue={tc['issue']} | open={sc['open']} merged={sc['merged']} closed={sc['closed']}")
    by_repo = {}
    for it in items:
        by_repo.setdefault(it[0]["repository"]["nameWithOwner"], []).append(it)
    repos = sorted(by_repo, key=lambda r: (-len(by_repo[r]), r))
    out.append("focus:")
    for r in repos:
        c = Counter(x[2] for x in by_repo[r])
        out.append(f"  {r} {len(by_repo[r])} ({round(100 * len(by_repo[r]) / max(1, len(items)))}%)"
                   f" authored={c['author']} reviewed={c['reviewer']} commented={c['commented']}")
    order = {"author": 0, "reviewer": 1, "commented": 2}
    for r in repos:
        out.append("")
        out.append(f"## {r} ({len(by_repo[r])})")
        for n, kind, role in sorted(by_repo[r], key=lambda x: (order[x[2]], x[1] != "pr", x[0]["createdAt"])):
            labels = [l["name"] for l in n["labels"]["nodes"]]
            out.append(f"- {role}:{kind}:{n['state'].lower()} #{n['number']} {n['createdAt'][:10]}"
                       + (f" acted={n['_acted']:%Y-%m-%d}" if "_acted" in n else "") + f" c={n['comments']['totalCount']}"
                       + (f" by={login(n['author'])}" if role != "author" else "")
                       + f" {n['title']}" + (f" [{','.join(labels)}]" if labels else "") + f" {n['url']}")
    print("\n".join(out))


