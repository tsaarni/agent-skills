commands:
  status    current PR status: CI, conflicts, reviews, threads, whose turn + waiting; --mine; --stats
  history   user's contributions over a period: PRs/issues authored, PRs reviewed, items commented
  inspect   details of specific PRs/issues: body, files, reviews, inline comments, comments

gh-activity <command> --help for options
"""


def main():
    cmds = {"status": cmd_status, "history": cmd_history, "inspect": cmd_inspect}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(USAGE, file=sys.stderr if len(sys.argv) >= 2 and sys.argv[1] not in ("-h", "--help") else sys.stdout)
        sys.exit(0 if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help") else 2)
    cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
