def run_default(api, args, now):
    q = build_query(args)
    total, nodes = api.search(q, args.limit, args.body > 0, args.comments) if args.limit else (None, [])
    api.enrich(nodes)
    items = [(n, analyze(n, now)) for n in nodes]
    return q, total, items


def run_mine(api, args, now):
    """PRs where it's my turn: review requested (direct or team), re-review after author update, or my PRs needing action.
    One advanced OR search for candidates + one light url-only search to tell which have my review requested."""
    scope = []
    if args.repos:  # advanced search ANDs repeated qualifiers: group repos with OR
        scope.append("(" + " OR ".join(f"repo:{r}" for r in args.repos) + ")")
    if args.since:
        scope.append(f"created:>={args.since}")
    if args.no_draft:
        scope.append("draft:false")
    q = " ".join(["is:pr is:open (review-requested:@me OR reviewed-by:@me OR author:@me)"] + scope + ["sort:updated-asc"])
    total, nodes = api.search(q, args.limit, args.body > 0, args.comments, advanced=True)
    rq = " ".join(["is:pr is:open review-requested:@me"] + [f"repo:{r}" for r in args.repos] + scope[1 if args.repos else 0:])
    n_req, requested = api.urls(rq, SEARCH_CAP)
    missing = requested - {n["url"] for n in nodes}
    if missing:  # candidates truncated by --limit: always include every PR requesting my review
        _, extra = api.search(rq + " sort:updated-asc", SEARCH_CAP, args.body > 0, args.comments)
        nodes += [n for n in extra if n["url"] in missing]
    api.enrich(nodes)
    me, items = api.viewer, []
    for n in nodes:
        a = analyze(n, now)
        my_review = max((ts(r["submittedAt"]) for r in n["latestReviews"]["nodes"] if login(r["author"]) == me), default=None)
        if a["author"] == me:
            if a["turn"] not in ("author", "merge"):  # merge: my approved PR, I merge it
                continue
            a["mine"] = "author"
        else:
            if a["turn"] not in ("reviewers", "merge", "maintainers"):  # maintainers: stuck bot PR, I'm requested
                continue
            if n["url"] in requested:
                a["mine"] = "review_requested"
                if my_review is None or my_review < a["last_author"]:
                    a["since"] = max(filter(None, [a["last_author"], my_review]))
            elif my_review and my_review < a["last_author"] and a["turn"] == "reviewers":
                a["mine"], a["why"], a["since"] = "re-review", "updated_since_my_review", a["last_author"]
            else:
                continue
            a["waiting_days"] = days(a["since"], now)
        items.append((n, a))
    trunc = f"(truncated to {len(nodes)}, raise --limit)" if len(nodes) < total else ""
    return q, f"candidates={total}{trunc} review_requested={n_req}", items


def cmd_status(argv):
    ap = argparse.ArgumentParser(
        prog="gh-activity status",
        description="Current PR status: CI, merge, reviews, whose turn and how long (compact text for AI agents).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  gh-activity status projectcontour/contour
  gh-activity status --author=app/dependabot projectcontour/contour tsaarni/certyaml
  gh-activity status --mine                                   # waiting on me, all repos
  gh-activity status --mine projectcontour/contour            # waiting on me, one repo
  gh-activity status --stats --limit=0 keycloak/keycloak      # repo counts only
  gh-activity status --stats --limit=50 --sort=waiting keycloak/keycloak
  gh-activity status --body=3000 --author=app/dependabot tsaarni/echoserver

turn: author | reviewers | merge (approved/ready, maintainers to merge) | maintainers (bot PR stuck) | ci (running)
waiting: days since the turn started (last author push/comment, last review/comment by others, approval)
""")
    ap.add_argument("repos", nargs="*", metavar="owner/repo")
    ap.add_argument("--mine", action="store_true", help="only PRs where it's my turn (review requested, re-review, or my PR needs action)")
    ap.add_argument("--stats", action="store_true", help="repo-level counts + stats over fetched PRs")
    ap.add_argument("--author", help="PR author: login, @me, or app/<name> (e.g. app/dependabot). default: any")
    ap.add_argument("--state", choices=["open", "closed", "merged", "all"], default="open", help="default: open")
    ap.add_argument("--since", type=parse_since, help="YYYY-MM-DD or Nd: created on/after (merged/closed on/after with --state=merged|closed)")
    ap.add_argument("--no-draft", action="store_true", help="exclude draft PRs")
    ap.add_argument("--limit", type=int, help=f"max PRs to fetch (default 30, --mine 100; max {SEARCH_CAP}; 0 = none)")
    ap.add_argument("--sort", choices=["repo", "age", "waiting"], help="repo, age (oldest first), waiting (longest first). default: repo, --mine: waiting")
    ap.add_argument("--comments", type=int, default=3, help="last N comments per PR (default 3)")
    ap.add_argument("--body", type=int, default=0, metavar="N", help="include first N chars of PR body (release notes etc.), default 0 = off")
    ap.add_argument("--top", type=int, metavar="N", help="show only first N PRs after sorting (fetch stays --limit; use for 'top N')")
    args = ap.parse_args(argv)
    for r in args.repos:
        if not REPO_RE.fullmatch(r):
            ap.error(f"invalid repo {r!r}, expected owner/repo")
    if not args.repos and not args.mine and not args.author:
        ap.error("give owner/repo(s), --author, or --mine")
    if args.stats and not args.repos and not args.author:
        ap.error("--stats needs owner/repo(s) or --author")
    if args.mine and args.author:
        ap.error("--mine and --author are exclusive")
    if args.limit is None:
        args.limit = 100 if args.mine else 30
    args.limit = max(0, min(args.limit, SEARCH_CAP))
    if args.mine and args.state != "open":
        ap.error("--mine works on open PRs only")
    if args.mine and not args.limit:
        ap.error("--mine needs --limit >= 1")
    args.sort = args.sort or ("waiting" if args.mine else "repo")

    now = datetime.now(timezone.utc)
    api = Api()
    out = []
    if args.mine:
        q, total, items = run_mine(api, args, now)
        out.append(f"query: {q}")
        out.append(f"me={api.viewer} {total} -> my_turn={len(items)}")
    else:
        q, total, items = run_default(api, args, now)
        if args.limit:
            out.append(f"query: {q}")
            out.append(f"me={api.viewer} matched={total} shown={len(items)}" + (" (truncated, raise --limit or narrow query)" if len(items) < total else ""))
            if total > SEARCH_CAP:
                out.append(f"warning: search caps at {SEARCH_CAP} results; narrow with --since/--author")
    if args.stats:
        out += repo_stats(api, args) + fetched_stats(items)
    out.append(f"api_cost={api.cost} remaining={api.remaining}")
    out += merge_methods([n for n, _ in items])

    key = {
        "age": lambda x: x[0]["createdAt"],
        "repo": lambda x: (x[0]["repository"]["nameWithOwner"], x[0]["number"]),
        "waiting": lambda x: -(x[1]["waiting_days"] or 0),
    }[args.sort]
    ranked = sorted(items, key=key)
    if args.top and len(ranked) > args.top:
        out.append(f"top={args.top} of {len(ranked)} (sorted by {args.sort})")
        ranked = ranked[:args.top]
    for i, (n, a) in enumerate(ranked, 1):
        render_pr(i, n, a, args, now, out)
    print("\n".join(out))


